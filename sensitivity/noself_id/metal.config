TRACKPOSITIONS ON
AVERAGEFREQ ON
MINMAXFREQ ON
SCHEME STDERR
#Column headers fem_bc
MARKER   CHRPOS
ALLELE   Allele2 Allele1
EFFECT   BETA
STDERR   SE
PVALUE   p.value
CHROMOSOMELABEL CHR
POSITIONLABEL POS
FREQLABEL AF_Allele2
WEIGHTLABEL N_total
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_fem_bc.txt
#Column headers fem_cc
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_fem_cc.txt
#Column headers fem_oc
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_fem_oc.txt
#Column headers male_oc
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_male_oc.txt
#Column headers fem_nc
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_fem_nc.txt
#Column headers male_nc
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_male_nc.txt
#Column headers ark_females
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_ark_fem.txt
#Column headers ark_males
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_ark_male.txt
#Column headers awi_gen_females south
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_awi_south_fem.txt
#Column headers awi_gen_males south
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_awi_south_male.txt
#Column headers awigen females east
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_awi_east_fem.txt
#Column headers awigen males east
PROCESS /spaces/jeantristan/isabel/hiv/hiv_noselfid/meta/format_data/meta_x_awi_east_male.txt
#Column headers uganda females
MARKER   CHRPOS
ALLELE   A2 A1
EFFECT   BETA
STDERR   SE
PVALUE   P
CHROMOSOMELABEL CHR
POSITIONLABEL BP
FREQLABEL FRQ
WEIGHTLABEL N
PROCESS /dataG/cancer/isabel_work/pGWAS/mungestat/uganda_fem_x/mungestats_uganda_fem_chrprefix.txt
#Column headers uganda males
PROCESS /dataG/cancer/isabel_work/pGWAS/mungestat/uganda_male_x/mungestats_uganda_male_chrprefix.txt
OUTFILE meta_hiv_africa_x .tbl
ANALYZE HETEROGENEITY
QUIT
